# Copy this file to .env and fill in your keys.

# --- Hindsight (memory) ---
# Get a key at https://ui.hindsight.vectorize.io (Connect page). Promo code: MEMHACK99
HINDSIGHT_API_KEY=
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_BANK_ID=incident-memory

# --- Groq (LLM) ---
# Get a key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Comma-separated; each Groq model has its own free-tier rate limit
GROQ_FALLBACK_MODEL=qwen/qwen3.8-27b,openai/gpt-oss-20b

# --- Mode ---
# auto  = use Hindsight if HINDSIGHT_API_KEY is set, otherwise the local offline store
# hindsight / local = force one backend
MEMORY_BACKEND=auto
